# Browser-safe Neon database base URL (not a PostgreSQL connection string).
# The local Neon checkout already provides NEON_AUTH_BASE_URL, which Vite maps
# to this SDK base URL at build time.
VITE_NEON_DATABASE_URL=https://your-neon-host.example/neondb

# Browser-safe URL for the DataClass storage signing Worker.
VITE_STORAGE_API_URL=http://localhost:8787
