# Browser-visible values only. Never place database credentials, OAuth secrets,
# B2 credentials, or other private values in a VITE_* variable.

# Required for production: the browser-safe Neon database base URL, not a
# PostgreSQL connection string. Local Neon checkout may instead provide
# NEON_AUTH_BASE_URL, which Vite derives into this SDK base URL.
VITE_NEON_DATABASE_URL=https://your-neon-browser-endpoint.example/neondb

# Development: optional; missing value falls back to the local Worker.
# Production: required and must be the deployed Cloudflare Worker HTTPS URL.
# The final production value will be known after the Worker is deployed.
VITE_STORAGE_API_URL=http://localhost:8787

# Required only for builds that route approved browser RPCs through the
# direct-Postgres gateway. Use an isolated Worker origin during staged tests.
VITE_RPC_GATEWAY_URL=https://your-isolated-rpc-gateway.example
